{
  "name": "unisonos",
  "private": true,
  "version": "0.0.0",
  "description": "UnisonOS monorepo — CC:Tweaked OS, Node bus/website server, shared protocol",
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev:server": "pnpm --filter @unison/server dev",
    "build": "pnpm -r --filter \"./packages/*\" build",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "migrate": "pnpm --filter @unison/server migrate"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
